# Safe development defaults. Replace this dummy value only in a private deployment
# environment; never commit a real Microsoft client secret or private TLS key.
PORT=8787
PACKSMITH_SERVER_DATA=./data
PACKSMITH_MS_CLIENT_ID=60cbe4bd-6824-4be1-9685-7fd5c33fff61
PACKSMITH_MS_CLIENT_SECRET=replace-with-a-real-client-secret
PACKSMITH_MS_REDIRECT_URI=https://auth.pack-smith.com/

# Set both paths to enable HTTPS directly in Node. Leave both empty when TLS is
# terminated by a reverse proxy. Paths are resolved from the process working directory.
PACKSMITH_SSL_CERT_PATH=
PACKSMITH_SSL_KEY_PATH=
